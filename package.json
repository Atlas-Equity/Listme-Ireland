{
  "name": "listit-root",
  "version": "1.0.0",
  "scripts": {
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && .\\mvnw.cmd spring-boot:run",
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "db:up": "docker-compose up -d",
    "db:down": "docker-compose down"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
